{
  "abstract" : [
    {
      "text" : "Adopt explicit model diagnostics and the Swift 6.4 toolchain.",
      "type" : "text"
    }
  ],
  "hierarchy" : {
    "paths" : [
      [
        "doc:\/\/TranscriptDebugMenu\/documentation\/TranscriptDebugMenu"
      ]
    ]
  },
  "identifier" : {
    "interfaceLanguage" : "swift",
    "url" : "doc:\/\/TranscriptDebugMenu\/documentation\/TranscriptDebugMenu\/MigratingTo2.0"
  },
  "kind" : "article",
  "metadata" : {
    "modules" : [
      {
        "name" : "TranscriptDebugMenu"
      }
    ],
    "role" : "article",
    "roleHeading" : "Article",
    "title" : "Migrating to TranscriptDebugMenu 2.0"
  },
  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "TranscriptDebugMenu 2.0 requires Xcode 27 and Swift 6.4. The deployment targets remain iOS 26, macOS 26, Mac Catalyst 26, and visionOS 26.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The transcript menu no longer assumes that every session uses ",
              "type" : "text"
            },
            {
              "code" : "SystemLanguageModel.default",
              "type" : "codeVoice"
            },
            {
              "text" : ". Supply the model that created the session so token counts and context limits remain correct:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "let model = SystemLanguageModel(useCase: .contentTagging)",
            "let session = LanguageModelSession(model: model)",
            "",
            "ContentView()",
            "    .transcriptDebugMenu(",
            "        session,",
            "        isPresented: $showTranscript,",
            "        configuration: .systemModel(model)",
            "    )"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "For a custom or dynamically selected model, provide a ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/TranscriptDebugMenu\/documentation\/TranscriptDebugMenu\/TranscriptDebugMenu\/ContextMetricsProvider",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ". If the model has no reliable token-count API, omit ",
              "type" : "text"
            },
            {
              "code" : "configuration",
              "type" : "codeVoice"
            },
            {
              "text" : " or pass ",
              "type" : "text"
            },
            {
              "code" : "TranscriptDebugMenu.Configuration()",
              "type" : "codeVoice"
            },
            {
              "text" : "; context progress stays hidden while the rest of the diagnostics remain available.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Both entry points now default to an empty configuration. ",
              "type" : "text"
            },
            {
              "code" : "TranscriptDebugMenu(session: session)",
              "type" : "codeVoice"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "code" : ".transcriptDebugMenu(session, isPresented: $showTranscript)",
              "type" : "codeVoice"
            },
            {
              "text" : " are supported without deprecation warnings. They display the transcript without context metrics and never assume a default model.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "For direct presentation, use ",
              "type" : "text"
            },
            {
              "code" : "TranscriptDebugMenu(session: session, configuration: .systemModel(model))",
              "type" : "codeVoice"
            },
            {
              "text" : ". Omit ",
              "type" : "text"
            },
            {
              "code" : "configuration",
              "type" : "codeVoice"
            },
            {
              "text" : " when a compatible counter is unavailable.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "System-model counting requires OS 26.4 or later. On OS 26.0–26.3, the menu still works but hides Context. On OS 27, Usage displays the session’s reported input, cached input, output, and reasoning tokens independently of the configured context counter. OS 27-only fields are shown only when available and present.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "TranscriptDebugMenu 2.0 also replaces the sentiment-only toolbar with a single Export menu. Use it to copy or share formatted transcript JSON, or choose Report Feedback… to open the detailed feedback composer.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The library no longer adds a retroactive ",
              "type" : "text"
            },
            {
              "code" : "Hashable",
              "type" : "codeVoice"
            },
            {
              "text" : " conformance to ",
              "type" : "text"
            },
            {
              "code" : "Transcript.Entry",
              "type" : "codeVoice"
            },
            {
              "text" : ". If your app relied on that conformance for navigation or collections, use entry IDs or an app-owned ",
              "type" : "text"
            },
            {
              "code" : "Hashable",
              "type" : "codeVoice"
            },
            {
              "text" : " route type instead.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
  "schemaVersion" : {
    "major" : 0,
    "minor" : 3,
    "patch" : 0
  },
