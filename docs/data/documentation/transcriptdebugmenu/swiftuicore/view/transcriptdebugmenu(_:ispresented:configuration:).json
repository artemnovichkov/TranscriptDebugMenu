          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "This view modifier provides a convenient way to present a ",
              "type" : "text"
            },
            {
              "code" : "TranscriptDebugMenu",
              "type" : "codeVoice"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "as a modal sheet that can be toggled on and off. The debug menu displays the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "transcript entries from the provided language model session in a navigable list.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "code" : [
            "struct ContentView: View {",
            "    @State private var showDebugMenu = false",
            "    private static let model = SystemLanguageModel.default",
            "    @State private var session = LanguageModelSession(model: ContentView.model)",
            "    ",
            "    var body: some View {",
            "        Button(\"Show Debug Menu\") {",
            "            showDebugMenu = true",
            "        }",
            "        .transcriptDebugMenu(",
            "            session,",
            "            isPresented: $showDebugMenu,",
            "            configuration: .systemModel(Self.model)",
            "        )",
            "    }",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        }
      ],
