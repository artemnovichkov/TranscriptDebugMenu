        {
          "anchor" : "Description",
          "level" : 2,
          "text" : "Description",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "TranscriptDebugMenu is a lightweight SwiftUI component designed to help developers inspect language model sessions. It displays every transcript entry and its metadata, model-specific context-window metrics, token usage, attachments, generation options, tool calls, reasoning, and structured output.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Features",
          "level" : 2,
          "text" : "Features",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "View, search, and filter every transcript entry type;",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Inspect formatted structured content, metadata, tool schemas, attachments, reasoning, and token usage;",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Calculate context-window usage with an explicitly configured model-specific provider;",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Copy individual values or export the complete ",
                      "type" : "text"
                    },
                    {
                      "code" : "Transcript",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " as formatted JSON;",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Create detailed ",
                      "type" : "text"
                    },
                    {
                      "code" : "LanguageModelFeedback",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " with sentiment, issue categories, explanations, and a desired response.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Installation",
          "level" : 2,
          "text" : "Installation",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Version 2.0 is in beta. Select an exact published beta tag from ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/github.com\/artemnovichkov\/TranscriptDebugMenu\/releases",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " to try it. The ",
              "type" : "text"
            },
            {
              "code" : "from: \"2.0.0\"",
              "type" : "codeVoice"
            },
            {
              "text" : " example below is for the stable release; use ",
              "type" : "text"
            },
            {
              "code" : "exact:",
              "type" : "codeVoice"
            },
            {
              "text" : " with a published beta tag during the beta period.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Add TranscriptDebugMenu to your project using Swift Package Manager:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "In Xcode, go to ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "File → Add Package Dependencies…",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Enter the repository URL:",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "code" : [
                    "https:\/\/github.com\/artemnovichkov\/TranscriptDebugMenu"
                  ],
                  "syntax" : null,
                  "type" : "codeListing"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Choose the version you want to use",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Add the package to your target",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Alternatively, add it to your ",
              "type" : "text"
            },
            {
              "code" : "Package.swift",
              "type" : "codeVoice"
            },
            {
              "text" : " file:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "dependencies: [",
            "    .package(url: \"https:\/\/github.com\/artemnovichkov\/TranscriptDebugMenu\", from: \"2.0.0\")",
            "]"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "Check out ",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/TranscriptDebugMenu\/tutorials\/TranscriptDebugMenu",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
                  "text" : " tutorial for a step-by-step guide.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Note",
          "style" : "note",
          "type" : "aside"
        },
        {
          "inlineContent" : [
            {
              "text" : "Import the library and use the transcript menu modifier on any SwiftUI view:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "import SwiftUI",
            "import FoundationModels",
            "import TranscriptDebugMenu",
            "",
            "struct ContentView: View {",
            "    @State private var showTranscript = false",
            "    private static let model = SystemLanguageModel.default",
            "    @State private var session = LanguageModelSession(model: ContentView.model)",
            "    ",
            "    var body: some View {",
            "        VStack {",
            "            Button(\"Show Transcript Menu\") {",
            "                showTranscript = true",
            "            }",
            "        }",
            "        .transcriptDebugMenu(",
            "            session,",
            "            isPresented: $showTranscript,",
            "            configuration: .systemModel(Self.model)",
            "        )",
            "    }",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "anchor" : "Requirements",
          "level" : 2,
          "text" : "Requirements",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "iOS 26.0+ \/ macOS 26.0+ \/ Mac Catalyst 26.0+ \/ visionOS 26.0+",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Swift 6.4+",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Xcode 27.0+",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Configure-context-metrics",
          "level" : 2,
          "text" : "Configure context metrics",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "code" : "LanguageModelSession",
              "type" : "codeVoice"
            },
            {
              "text" : " doesn’t expose its model. Pass the same ",
              "type" : "text"
            },
            {
              "code" : "SystemLanguageModel",
              "type" : "codeVoice"
            },
            {
              "text" : " instance used to create the session so the menu uses the correct tokenizer and context size:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "let model = SystemLanguageModel(useCase: .contentTagging)",
            "let session = LanguageModelSession(model: model)",
            "let configuration = TranscriptDebugMenu.Configuration.systemModel(model)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "For dynamic, cloud, or custom models, pass a custom ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/TranscriptDebugMenu\/documentation\/TranscriptDebugMenu\/TranscriptDebugMenu\/ContextMetricsProvider",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ". Omit ",
              "type" : "text"
            },
            {
              "code" : "configuration",
              "type" : "codeVoice"
            },
            {
              "text" : " when a reliable token counter isn’t available; no model is assumed; the menu will hide context progress while continuing to display the session’s reported usage.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "System-model context metrics require iOS 26.4, macOS 26.4, Mac Catalyst 26.4, or visionOS 26.4. Counting failures and invalid metrics hide the Context section. Usage is available on OS 27 and reports session usage separately from context-window consumption. Attachments, reasoning, and other OS 27 diagnostics appear only when supported and present in the transcript.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Export-and-feedback",
          "level" : 2,
          "text" : "Export and feedback",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Open the Export menu in the toolbar to copy or share the complete transcript as formatted JSON, including entries hidden by search. In the same menu, choose Report Feedback… to select sentiment and issues, add explanations, and describe the desired response. Share the resulting ",
              "type" : "text"
            },
            {
              "code" : "LanguageModelFeedback",
              "type" : "codeVoice"
            },
            {
              "text" : " JSON from the feedback form with Feedback Assistant; this does not submit a report automatically.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
