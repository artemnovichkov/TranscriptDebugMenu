          "contentSection" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Start with a SwiftUI project targeting iOS 26 or later in Xcode 27 with Swift 6.4. To generate the haiku, run on a device that supports Apple Intelligence with the system model available. If generation fails, the example displays the error.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "kind" : "contentAndMedia",
              "mediaPosition" : "trailing"
            }
