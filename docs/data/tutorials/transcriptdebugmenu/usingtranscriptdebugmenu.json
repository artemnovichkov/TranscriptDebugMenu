              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Keep a reference to ",
                      "type" : "text"
                    },
                    {
                      "code" : "SystemLanguageModel.default",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " and use it to create ",
                      "type" : "text"
                    },
                    {
                      "code" : "LanguageModelSession",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ". Write a prompt to generate a haiku about Swift. Keep the same model for the debug menu’s token counter later.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
