              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Create a new SwiftUI project in Xcode. Open ",
                      "type" : "text"
                    },
                    {
                      "code" : "ContentView.swift",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " and update the content.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
