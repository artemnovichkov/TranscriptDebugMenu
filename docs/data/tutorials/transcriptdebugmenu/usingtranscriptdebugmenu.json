        {
          "anchor" : "Interact-with-the-transcript",
          "contentSection" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "The menu updates as the session transcript changes. The fields you see depend on the OS version and the content of the session. Screenshots use sample data; generated responses and token counts will vary.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "kind" : "contentAndMedia",
              "mediaPosition" : "trailing"
            }
          ],
          "stepsSection" : [
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Inspect Context to see token consumption relative to the configured model’s context window. System-model counting requires OS 26.4 or later. If counting fails, Context is hidden. For a custom or dynamic model without a reliable counter, omit ",
                      "type" : "text"
                    },
                    {
                      "code" : "configuration",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "; a custom ",
                      "type" : "text"
                    },
                    {
                      "code" : "TranscriptDebugMenu.ContextMetricsProvider",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " can supply metrics when available.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "On OS 27, expand Usage to inspect input, cached input, output, and reasoning tokens reported by the session. These usage values are separate from Context and remain available without a context provider. Reasoning, attachments, and additional metadata appear only when the transcript contains them and the OS supports them.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Activate Search, enter a word or entry ID, and select an entry-type scope. Search also matches structured values, tool arguments, and metadata. Clearing the search text restores the complete transcript.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Tap an entry to read its text or structured output first, followed by generation options and the response format when present. Expand Schema to inspect the response JSON schema. Entry, segment, and tool call IDs are available in the collapsed Technical Details block at the bottom. Long-press a value there to copy it. On OS 27, image attachments can be opened in a preview.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : "screenshot2.png",
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Long-press an entry or an individual value to copy it. Structured content, tool arguments, and metadata are formatted as readable JSON.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            }
          ],
          "title" : "Interact with the transcript"
        },
        {
          "anchor" : "Export-and-prepare-feedback",
          "contentSection" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Transcript export and model feedback produce different JSON attachments. Export captures the full transcript, including entries hidden by search. Feedback adds your assessment and expected response.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "kind" : "contentAndMedia",
              "mediaPosition" : "trailing"
            }
          ],
          "stepsSection" : [
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Tap the Export button (the square with an upward arrow) in the toolbar and choose Copy Transcript JSON or Share Transcript JSON. The exported JSON is formatted for readability and includes the current complete transcript.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "In the same Export menu, choose Report Feedback… to open the feedback form. Record session-level sentiment, select issue categories, explain each issue, and provide the response you expected.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : "feedback.png",
              "runtimePreview" : null,
              "type" : "step"
            },
            {
              "caption" : [

              ],
              "code" : null,
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "In Feedback, choose Share to save or share the generated ",
                      "type" : "text"
                    },
                    {
                      "code" : "LanguageModelFeedback",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " JSON. Attach the file to a report in Feedback Assistant. Sharing the attachment does not submit a report automatically. If saving fails, use Retry before sharing.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ],
              "media" : null,
              "runtimePreview" : null,
              "type" : "step"
            }
          ],
          "title" : "Export and prepare feedback"
        }
      ]
    }
