                    {
                      "text" : "Add TranscriptDebugMenu to your project using Swift Package Manager:",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
